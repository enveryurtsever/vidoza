# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_id_here

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Media APIs (Pixabay & Pexels)
PIXABAY_API_KEY=your_pixabay_api_key
PEXELS_API_KEY=your_pexels_api_key

# YouTube OAuth
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback

# TikTok OAuth
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# Instagram / Facebook OAuth
# (Uses Facebook App ID/Secret as primary, Instagram vars are optional fallback)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback

# Dashboard Login
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123

# Server & Session
PORT=3000
SESSION_SECRET=change-this-secret-for-production
NODE_ENV=development

# TTS (Optional, defaults provided)
TTS_SPEED=1.0

# Performance
JOB_TIMEOUT_MS=900000
