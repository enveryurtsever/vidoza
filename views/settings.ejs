<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head', { title: 'Settings' }) %>
</head>

<body>
  <%- include('partials/sidebar', { activePage: 'settings' }) %>

    <div class="main">
      <div class="topbar">
        <h2>Settings</h2>
      </div>
      <div class="content">
        <% if (message) { %>
          <div class="alert alert-success">
            <%= message %>
          </div>
          <% } %>
            <% if (error) { %>
              <div class="alert alert-error">
                <%= error %>
              </div>
              <% } %>

                <div class="card">
                  <div class="card-header">
                    <h3>Connected Accounts</h3>
                  </div>
                  <div class="card-body">
                    <% if (connections.length===0) { %>
                      <p>No accounts connected yet. Connect your social media accounts below.</p>
                      <% } else { %>
                        <div class="channel-list">
                          <% connections.forEach(conn=> { %>
                            <div class="channel-item">
                              <div class="channel-info">
                                <span class="platform-tag tag-<%= conn.provider %>">
                                  <%= conn.provider %>
                                </span>
                                <strong>
                                  <%= conn.account_name %>
                                </strong>
                              </div>
                              <form method="POST" action="/auth/disconnect/<%= conn.id %>"
                                data-confirm="Are you sure you want to disconnect this account?">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Disconnect</button>
                              </form>
                            </div>
                            <% }) %>
                        </div>
                        <% } %>
                  </div>
                </div>

                <div class="grid grid-3 mt-30">
                  <!-- YouTube -->
                  <div class="card">
                    <div class="card-header">
                      <h3><i data-lucide="youtube" class="icon" style="color: #ef4444;"></i> YouTube</h3>
                    </div>
                    <div class="card-body">
                      <% if (!youtubeConfigured) { %>
                        <p class="text-muted small">Not configured in .env</p>
                        <% } else { %>
                          <p>Connect multiple YouTube channels to upload</p> <a href="/auth/youtube"
                            class="btn btn-connect">Connect New Account</a>
                          <% } %>
                    </div>
                  </div>

                  <!-- TikTok -->
                  <div class="card">
                    <div class="card-header">
                      <h3><i data-lucide="music" class="icon" style="color: #fff;"></i> TikTok</h3>
                    </div>
                    <div class="card-body">
                      <% if (!tiktokConfigured) { %>
                        <p class="text-muted small">Not configured in .env</p>
                        <% } else { %>
                          <p>Connect your TikTok account to enable automatic uploads.</p>
                          <a href="/auth/tiktok" class="btn btn-connect">Connect New Account</a>
                          <% } %>
                    </div>
                  </div>

                  <!-- Instagram -->
                  <div class="card">
                    <div class="card-header">
                      <h3><i data-lucide="instagram" class="icon" style="color: #ec4899;"></i> Instagram</h3>
                    </div>
                    <div class="card-body">
                      <% if (!instagramConfigured) { %>
                        <p class="text-muted small">Not configured in .env</p>
                        <% } else { %>
                          <p>Instagram Reels integration is now available.</p>
                          <a href="/auth/instagram" class="btn btn-connect">Connect Instagram</a>
                          <% } %>
                    </div>
                  </div>
                </div>
      </div>
    </div>
    <script src="/js/ui.js"></script>
</body>

</html>